        "lineageTag": "ed91c065-1290-43d5-8232-530a6f221b12",
        "measures": [
          {
            "name": "Gross Sales",
            "displayFolder": "Performance",
            "expression": "SUM(Movements[revenue])",
            "formatString": "\"GEL \"#,0.00;\"GEL \"-#,0.00;\"GEL \"0.00",
            "lineageTag": "905efeaa-24a6-4f9a-bdf4-9c03a04ecf6c"
          },
          {
            "name": "Refunds",
            "displayFolder": "Performance",
            "expression": "SUM(Movements[refunds])",
            "formatString": "\"GEL \"#,0.00;\"GEL \"-#,0.00;\"GEL \"0.00",
            "lineageTag": "ab542daf-527d-4e4d-87b4-a756d5ac9d15"
          },
          {
            "name": "Net Revenue",
            "displayFolder": "Performance",
            "expression": "[Gross Sales] - [Refunds]",
            "formatString": "\"GEL \"#,0.00;\"GEL \"-#,0.00;\"GEL \"0.00",
            "lineageTag": "158be05d-9f05-4230-ac33-0d327265c33a"
          },
          {
            "name": "Net COGS",
            "displayFolder": "Performance",
            "expression": "SUM(Movements[cogs])",
            "formatString": "\"GEL \"#,0.00;\"GEL \"-#,0.00;\"GEL \"0.00",
            "lineageTag": "4bde5255-ba29-40b6-adf3-dd81a5c5005d"
          },
          {
            "name": "Gross Profit",
            "displayFolder": "Performance",
            "expression": "[Net Revenue] - [Net COGS]",
            "formatString": "\"GEL \"#,0.00;\"GEL \"-#,0.00;\"GEL \"0.00",
            "lineageTag": "e23a0786-d869-449f-8185-5e8b860bca54"
          },
          {
            "name": "Gross Margin",
            "displayFolder": "Ratios",
            "expression": "DIVIDE([Gross Profit], [Net Revenue])",
            "formatString": "0.0%",
            "lineageTag": "e956e4f1-d89d-4df1-a660-cdc5ebee70ad"
          },
          {
            "name": "Orders",
            "displayFolder": "Performance",
            "expression": "CALCULATE(DISTINCTCOUNT(Movements[order_id]), Movements[sold_units] > 0)",
            "formatString": "#,0",
            "lineageTag": "524297ac-93fa-4bf2-a17f-e1b7ec06a2f8"
          },
          {
            "name": "Average Order Value",
            "displayFolder": "Performance",
            "expression": "DIVIDE([Gross Sales], [Orders])",
            "formatString": "\"GEL \"#,0.00;\"GEL \"-#,0.00;\"GEL \"0.00",
            "lineageTag": "4d45a35e-25dc-4cc6-85c1-4da02a7a3a4e"
          },
          {
            "name": "Sold Units",
            "displayFolder": "Performance",
            "expression": "SUM(Movements[sold_units])",
            "formatString": "#,0",
            "lineageTag": "6a4634d8-66c3-4adb-b935-6c04fe49c292"
          },
          {
            "name": "Returned Units",
            "displayFolder": "Performance",
            "expression": "SUM(Movements[returned_units])",
            "formatString": "#,0",
            "lineageTag": "106edfe1-9c24-4d20-b924-5808b59ca1bb"
          },
          {
            "name": "Period Return Unit Ratio",
            "displayFolder": "Ratios",
            "expression": "DIVIDE([Returned Units], [Sold Units])",
            "formatString": "0.0%",
            "lineageTag": "4f766c6d-2d6b-4ffb-93e7-3393319ca125"
          },
          {
