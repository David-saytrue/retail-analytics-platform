        "lineageTag": "0d2fc869-b271-4580-a90a-ed77da57043d",
        "partitions": [
          {
            "name": "Movements",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Snapshot = #table({\"movement_id\", \"event_date\", \"order_id\", \"customer_id\", \"product_id\", \"sold_units\", \"returned_units\", \"revenue\", \"refunds\", \"cogs\"}, {",
                "        {\"sale:1\", #datetime(2026,1,1,0,0,0), 1, 1, 1, 2, 0, 180.0, 0, 120.0},",
                "        {\"sale:2\", #datetime(2026,1,1,0,0,0), 1, 1, 2, 1, 0, 70.0, 0, 20.0},",
                "        {\"sale:3\", #datetime(2026,1,1,0,0,0), 2, 2, 3, 3, 0, 30.0, 0, 12.0},",
                "        {\"return:1\", #datetime(2026,1,2,0,0,0), 1, 1, 1, 0, 1, 0, 90.0, -60.0}",
                "    }),",
                "    Source = if UsePostgreSQL then PostgreSQL.Database(\"127.0.0.1:55432\", \"retail\", [CreateNavigationProperties=false]){[Schema=\"mart\",Item=\"movements\"]}[Data] else Snapshot,",
                "    Typed = Table.TransformColumnTypes(Source, {{\"movement_id\", type text}, {\"event_date\", type datetime}, {\"order_id\", Int64.Type}, {\"customer_id\", Int64.Type}, {\"product_id\", Int64.Type}, {\"sold_units\", Int64.Type}, {\"returned_units\", Int64.Type}, {\"revenue\", Currency.Type}, {\"refunds\", Currency.Type}, {\"cogs\", Currency.Type}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
